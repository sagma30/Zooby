# Gemini AI — required for AI features
# In AI Studio this is injected automatically from user secrets
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# App URL — injected by AI Studio at runtime (Cloud Run service URL)
APP_URL="MY_APP_URL"

# Backend API base URL — update to match your backend server
VITE_API_URL="http://localhost:5000/api/v1"
